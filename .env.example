# Application Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# SQLite Configuration (Legacy - will be replaced by MySQL)
SQLITE_PATH=data/waitlist.db

# MySQL/Prisma Configuration
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker: mysql://seatix_user:seatix_password@mysql:3306/seatix_waitlist
# For Local: mysql://seatix_user:seatix_password@localhost:3306/seatix_waitlist
DATABASE_URL="mysql://seatix_user:seatix_password@localhost:3306/seatix_waitlist"

# MySQL Adapter Configuration (for Docker, use mysql as host)
DATABASE_HOST=localhost
DATABASE_USER=seatix_user
DATABASE_PASSWORD=seatix_password
DATABASE_NAME=seatix_waitlist

# Offer Configuration
OFFER_TTL_MINUTES=10

